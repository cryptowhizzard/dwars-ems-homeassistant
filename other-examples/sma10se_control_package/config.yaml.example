## Example - Please adjust to your own needs.

# Loads default set of integrations. Do not remove.
default_config:

# Load frontend themes from the themes folder
frontend:
  themes: !include_dir_merge_named themes

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml


template:
  - sensor:
      - name: "Netto netvermogen"
        unique_id: netto_netvermogen
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: >
          {% set absorbed = states('sensor.shm2_em_metering_power_absorbed') | float(0) %}
          {% set supplied = states('sensor.shm2_em_metering_power_supplied') | float(0) %}
          {{ (absorbed - supplied) | round(0) }}

      - name: "Netto productie totaal"
        unique_id: netto_productie_totaal
        unit_of_measurement: "W"
        device_class: power
        state_class: measurement
        state: >
          {% set discharge = states('sensor.sn_3017472689_battery_power_discharge_total') | float(0) %}
          {% set charge = states('sensor.sn_3017472689_battery_power_charge_total') | float(0) %}
          {% set pv = states('sensor.sn_3017472689_pv_power') | float(0) %}
          {{ (pv + discharge - charge) | round(0) }}

# ==========================
# SMA Sunny Tripower 10.0 SE (Modbus TCP)
# ==========================
modbus:
  - name: sma
    type: tcp
    host: 192.168.x.x
    port: 502

    # Batterij sensoren (lezen)
    sensors:
      - name: SMA Battery SOC
        unit_of_measurement: "%"
        slave: 3
        address: 30845
        input_type: holding
        data_type: uint16

      - name: SMA Battery Power
        unit_of_measurement: "W"
        slave: 3
        address: 30775
        input_type: holding
        data_type: int16

      - name: SMA Grid Power
        unit_of_measurement: "W"
        slave: 3
        address: 30783
        input_type: holding
        data_type: int16

    # Aansturing registers (schrijven)
    switches:
      - name: SMA Manual Control
        slave: 3
        write_type: holding
        address: 40151
        command_on: 802      # Activeer handmatige besturing
        command_off: 803     # Terug naar automatisch

    number:
      - name: SMA Power Setpoint
        slave: 3
        write_type: holding
        address: 40149
        min_value: -10000    # Negatief = ontladen
        max_value: 10000     # Positief = laden
        step: 100
        unit_of_measurement: "W"
