{
  "name": "GoodWe Agent",
  "version": "1.5.22",
  "slug": "goodwe_agent",
  "description": "Bridge central server mode voor GoodWe. Stuurt GoodWe EMS mode via Home Assistant select/number/switch entities in plaats van Modbus, inclusief multi-inverter support voor EMS mode, power en grid export curtailment.",
  "startup": "services",
  "boot": "auto",
  "homeassistant_api": true,
  "hassio_api": true,
  "stage": "experimental",
  "arch": [
    "aarch64",
    "armv7",
    "amd64"
  ],
  "init": false,
  "host_network": false,
  "options": {
    "api_url": "https://api.metdezon.nl/bms/api/next_action.php",
    "telemetry_url": "https://api.metdezon.nl/bms/api/telemetry.php",
    "api_key": "",
    "client_id": "",
    "poll_interval": 60,
    "power_watt": 5000,
    "soc_entity": "sensor.goodwe_battery_state_of_charge",
    "mode_entity": "",
    "pv_entity": "sensor.goodwe_pv_power",
    "grid_entity": "sensor.goodwe_active_power",
    "debug": 1,
    "ha_url": "",
    "ha_token": "",
    "ha_control_enabled": true,
    "ha_ems_mode_select": "select.goodwe_ems_mode",
    "ha_ems_power_number": "number.goodwe_eco_mode_power",
    "ha_ems_power_value": "max",
    "ha_ems_set_power_modes": "3,4",
    "ha_ems_set_power_before_mode": true,
    "ha_ems_mode_1_option": "battery_standby",
    "ha_ems_mode_3_option": "import_ac",
    "ha_ems_mode_4_option": "export_ac",
    "ha_ems_mode_7_option": "charge_pv",
    "ha_grid_export_limit_number": "number.goodwe_net_exportlimiet",
    "ha_grid_export_limit_switch": "switch.goodwe_grid_export_limit_switch",
    "ha_grid_export_limit_off_value": "0",
    "ha_grid_export_limit_default_value": "max",
    "ha_grid_export_limit_switch_curtail_state": "on",
    "ha_grid_export_limit_switch_restore_state": "off",
    "ha_pv_curtail_below_eur_kwh": "",
    "ha_pv_curtail_enabled": true
  },
  "schema": {
    "api_url": "str",
    "telemetry_url": "str?",
    "api_key": "str?",
    "client_id": "str?",
    "poll_interval": "int",
    "power_watt": "int",
    "soc_entity": "str",
    "mode_entity": "str?",
    "pv_entity": "str?",
    "grid_entity": "str?",
    "debug": "int",
    "ha_url": "str?",
    "ha_token": "str?",
    "ha_control_enabled": "bool",
    "ha_ems_mode_select": "str?",
    "ha_ems_power_number": "str?",
    "ha_ems_power_value": "str?",
    "ha_ems_set_power_modes": "str?",
    "ha_ems_set_power_before_mode": "bool",
    "ha_ems_mode_1_option": "str?",
    "ha_ems_mode_3_option": "str?",
    "ha_ems_mode_4_option": "str?",
    "ha_ems_mode_7_option": "str?",
    "ha_grid_export_limit_number": "str?",
    "ha_grid_export_limit_switch": "str?",
    "ha_grid_export_limit_off_value": "str?",
    "ha_grid_export_limit_default_value": "str?",
    "ha_grid_export_limit_switch_curtail_state": "str?",
    "ha_grid_export_limit_switch_restore_state": "str?",
    "ha_pv_curtail_below_eur_kwh": "str?",
    "ha_pv_curtail_enabled": "bool"
  },
  "build_from": {
    "aarch64": "ghcr.io/home-assistant/aarch64-base:3.19",
    "amd64": "ghcr.io/home-assistant/amd64-base:3.19",
    "armv7": "ghcr.io/home-assistant/armv7-base:3.19"
  },
  "url": "https://github.com/cryptowhizzard/dwars-ems-homeassistant/tree/main/goodwe_agent",
  "hassio_role": "default"
}
