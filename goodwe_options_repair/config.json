{
  "name": "GoodWe Legacy Options Migrator",
  "version": "0.2.1",
  "slug": "goodwe_options_repair",
  "description": "One-shot migratie voor GoodWe Agent <1.7: reset alle legacy options vóór de update en behoud uitsluitend api_key en ha_token.",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "startup": "once",
  "boot": "manual",
  "init": false,
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": false,
  "options": {
    "target_slug": "auto",
    "run_update": true,
    "restart_after_update": true,
    "preserve_only_api_key_and_ha_token": true
  },
  "schema": {
    "target_slug": "str",
    "run_update": "bool",
    "restart_after_update": "bool",
    "preserve_only_api_key_and_ha_token": "bool"
  },
  "map": [
    "config:rw"
  ]
}
