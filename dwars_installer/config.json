{
  "name": "DWARS Installer & Updater",
  "version": "0.2.1",
  "slug": "dwars_installer",
  "description": "Installeert en update DWARS custom components en inverter agents voor GoodWe en SolarEdge vanuit één repository.",
  "url": "https://github.com/cryptowhizzard/dwars-ems-homeassistant/tree/main/dwars_installer",
  "startup": "services",
  "boot": "auto",
  "arch": [
    "aarch64",
    "armv7",
    "amd64"
  ],
  "init": false,
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "manager",
  "stage": "experimental",
  "map": [
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/homeassistant_config"
    }
  ],
  "options": {
    "inverter_type": "both",
    "install_custom_components": true,
    "install_agent_addons": true,
    "configure_agent_addons": true,
    "start_agent_addons": false,
    "enable_addon_auto_update": true,
    "restart_homeassistant_after_custom_component": true,
    "watch_for_embedded_updates": true,
    "auto_update_from_github": false,
    "github_repo_zip_url": "https://github.com/cryptowhizzard/dwars-ems-homeassistant/archive/refs/heads/main.zip",
    "update_check_interval_sec": 21600,
    "goodwe_agent_api_url": "https://api.metdezon.nl/bms/api/next_action.php",
    "goodwe_agent_telemetry_url": "https://api.metdezon.nl/bms/api/telemetry.php",
    "goodwe_agent_api_key": "",
    "goodwe_agent_client_id": "",
    "goodwe_agent_poll_interval": 60,
    "goodwe_agent_power_watt": 5000,
    "goodwe_agent_debug": true,
    "goodwe_agent_ha_ems_mode_select": "select.goodwe_ems_mode",
    "goodwe_agent_ha_ems_power_number": "number.goodwe_eco_mode_power",
    "goodwe_agent_ha_ems_mode_0_option": "auto",
    "goodwe_agent_ha_grid_export_limit_number": "number.goodwe_net_exportlimiet",
    "goodwe_agent_ha_grid_export_limit_switch": "switch.goodwe_grid_export_limit_switch",
    "solaredge_agent_api_key": "",
    "solaredge_agent_client_id": 1,
    "solaredge_agent_api_url": "https://api.metdezon.nl/bms/api/next_action.php",
    "solaredge_agent_telemetry_url": "https://api.metdezon.nl/bms/api/heartbeat.php",
    "solaredge_agent_interval_sec": 60,
    "solaredge_agent_debug": 1,
    "solaredge_agent_verify_ssl": true,
    "solaredge_agent_ha_grid_sensor": "sensor.electricity_meter_power_consumption",
    "solaredge_agent_ha_pv_sensor": "sensor.solaredge_zonne_energie",
    "solaredge_agent_ha_soc_sensor": "sensor.solaredge_storage_level",
    "solaredge_agent_ha_cmd_mode_select": "select.solaredge_storage_remote_command_mode,select.solaredge2_storage_remote_command_mode,select.solaredge3_storage_remote_command_mode",
    "solaredge_agent_ha_default_mode_select": "select.solaredge_storage_default_mode,select.solaredge2_storage_default_mode,select.solaredge3_storage_default_mode",
    "solaredge_agent_ha_control_mode_select": "select.solaredge_storage_control_mode,select.solaredge2_storage_control_mode,select.solaredge3_storage_control_mode",
    "solaredge_agent_ha_command_timeout_number": "number.solaredge_storage_remote_command_timeout,number.solaredge2_storage_remote_command_timeout,number.solaredge3_storage_remote_command_timeout",
    "solaredge_agent_ha_remote_charge_limit_number": "number.solaredge_storage_remote_charge_limit,number.solaredge2_storage_remote_charge_limit,number.solaredge3_storage_remote_charge_limit",
    "solaredge_agent_ha_remote_discharge_limit_number": "number.solaredge_storage_remote_discharge_limit,number.solaredge2_storage_remote_discharge_limit,number.solaredge3_storage_remote_discharge_limit",
    "solaredge_agent_ha_command_timeout_sec": 21600,
    "solaredge_agent_auto_discover_entities": true,
    "solaredge_agent_ha_pv_active_power_limit_number": "number.solaredge2_active_power_limit",
    "solaredge_agent_ha_pv_active_power_limit_default_percent": 65,
    "solaredge_agent_ha_pv_active_power_limit_off_percent": 0,
    "solaredge_agent_ha_pv_curtail_below_eur_kwh": -0.12,
    "solaredge_agent_ha_pv_curtail_enabled": true
  },
  "schema": {
    "inverter_type": "list(goodwe|solaredge|both)",
    "install_custom_components": "bool",
    "install_agent_addons": "bool",
    "configure_agent_addons": "bool",
    "start_agent_addons": "bool",
    "enable_addon_auto_update": "bool",
    "restart_homeassistant_after_custom_component": "bool",
    "watch_for_embedded_updates": "bool",
    "update_check_interval_sec": "int",
    "goodwe_agent_api_url": "str",
    "goodwe_agent_telemetry_url": "str?",
    "goodwe_agent_api_key": "str?",
    "goodwe_agent_client_id": "str?",
    "goodwe_agent_poll_interval": "int",
    "goodwe_agent_power_watt": "int",
    "goodwe_agent_debug": "bool",
    "goodwe_agent_ha_ems_mode_select": "str?",
    "goodwe_agent_ha_ems_power_number": "str?",
    "goodwe_agent_ha_ems_mode_0_option": "str?",
    "goodwe_agent_ha_grid_export_limit_number": "str?",
    "goodwe_agent_ha_grid_export_limit_switch": "str?",
    "solaredge_agent_api_key": "str?",
    "solaredge_agent_client_id": "int",
    "solaredge_agent_api_url": "str",
    "solaredge_agent_telemetry_url": "str",
    "solaredge_agent_interval_sec": "int",
    "solaredge_agent_debug": "int",
    "solaredge_agent_verify_ssl": "bool",
    "solaredge_agent_ha_grid_sensor": "str",
    "solaredge_agent_ha_pv_sensor": "str",
    "solaredge_agent_ha_soc_sensor": "str",
    "solaredge_agent_ha_cmd_mode_select": "str",
    "solaredge_agent_ha_default_mode_select": "str",
    "solaredge_agent_ha_control_mode_select": "str",
    "solaredge_agent_ha_command_timeout_number": "str",
    "solaredge_agent_ha_remote_charge_limit_number": "str?",
    "solaredge_agent_ha_remote_discharge_limit_number": "str?",
    "solaredge_agent_ha_command_timeout_sec": "int",
    "solaredge_agent_auto_discover_entities": "bool",
    "solaredge_agent_ha_pv_active_power_limit_number": "str?",
    "solaredge_agent_ha_pv_active_power_limit_default_percent": "float",
    "solaredge_agent_ha_pv_active_power_limit_off_percent": "float",
    "solaredge_agent_ha_pv_curtail_below_eur_kwh": "float?",
    "solaredge_agent_ha_pv_curtail_enabled": "bool",
    "auto_update_from_github": "bool",
    "github_repo_zip_url": "str?"
  },
  "build_from": {
    "aarch64": "ghcr.io/home-assistant/aarch64-base:3.19",
    "amd64": "ghcr.io/home-assistant/amd64-base:3.19",
    "armv7": "ghcr.io/home-assistant/armv7-base:3.19"
  }
}
