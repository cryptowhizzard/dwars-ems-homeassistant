{
  "name": "DWARS SolarEdge Agent",
  "version": "3.4.3",
  "slug": "solaredge_agent",
  "description": "Stuurt SolarEdge BMS/EMS aan via centrale API en Home Assistant select/number entities. Ondersteunt meerdere omvormers, SolarEdge optie-aliases, PV-curtailment en entity auto-discovery.",
  "arch": [
    "amd64",
    "aarch64",
    "armv7"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "stage": "experimental",
  "host_network": true,
  "map": [
    "config:rw"
  ],
  "homeassistant_api": true,
  "options": {
    "api_key": "",
    "client_id": 1,
    "api_url": "https://api.metdezon.nl/bms/api/next_action.php",
    "telemetry_url": "https://api.metdezon.nl/bms/api/heartbeat.php",
    "interval_sec": 60,
    "debug": 1,
    "verify_ssl": true,
    "hass_url": "http://supervisor/core",
    "hass_token": "",
    "ha_grid_sensor": "sensor.electricity_meter_power_consumption",
    "ha_pv_sensor": "sensor.solaredge_zonne_energie",
    "ha_soc_sensor": "sensor.solaredge_storage_level",
    "ha_cmd_mode_select": "select.solaredge_storage_remote_command_mode,select.solaredge2_storage_remote_command_mode,select.solaredge3_storage_remote_command_mode",
    "ha_default_mode_select": "select.solaredge_storage_default_mode,select.solaredge2_storage_default_mode,select.solaredge3_storage_default_mode",
    "ha_control_mode_select": "select.solaredge_storage_control_mode,select.solaredge2_storage_control_mode,select.solaredge3_storage_control_mode",
    "ha_command_timeout_number": "number.solaredge_storage_remote_command_timeout,number.solaredge2_storage_remote_command_timeout,number.solaredge3_storage_remote_command_timeout",
    "ha_remote_charge_limit_number": "number.solaredge_storage_remote_charge_limit,number.solaredge2_storage_remote_charge_limit,number.solaredge3_storage_remote_charge_limit",
    "ha_remote_discharge_limit_number": "number.solaredge_storage_remote_discharge_limit,number.solaredge2_storage_remote_discharge_limit,number.solaredge3_storage_remote_discharge_limit",
    "ha_command_timeout_sec": 21600,
    "auto_discover_entities": true,
    "ha_pv_active_power_limit_number": "number.solaredge2_active_power_limit",
    "ha_pv_active_power_limit_default_percent": 65,
    "ha_pv_active_power_limit_off_percent": 0,
    "ha_pv_curtail_below_eur_kwh": -0.12,
    "ha_pv_curtail_enabled": true,
    "backup_yaml_check_enabled": true,
    "backup_yaml_path": "/config/backup.yaml",
    "backup_yaml_overwrite": false
  },
  "schema": {
    "api_key": "str?",
    "client_id": "int",
    "api_url": "str",
    "telemetry_url": "str",
    "interval_sec": "int",
    "debug": "int",
    "verify_ssl": "bool",
    "hass_url": "str",
    "hass_token": "password",
    "ha_grid_sensor": "str",
    "ha_pv_sensor": "str",
    "ha_soc_sensor": "str",
    "ha_cmd_mode_select": "str",
    "ha_default_mode_select": "str",
    "ha_control_mode_select": "str",
    "ha_command_timeout_number": "str",
    "ha_remote_charge_limit_number": "str?",
    "ha_remote_discharge_limit_number": "str?",
    "ha_command_timeout_sec": "int",
    "auto_discover_entities": "bool",
    "ha_pv_active_power_limit_number": "str?",
    "ha_pv_active_power_limit_default_percent": "float",
    "ha_pv_active_power_limit_off_percent": "float",
    "ha_pv_curtail_below_eur_kwh": "float?",
    "ha_pv_curtail_enabled": "bool",
    "backup_yaml_check_enabled": "bool",
    "backup_yaml_path": "str",
    "backup_yaml_overwrite": "bool"
  },
  "build_from": {
    "aarch64": "ghcr.io/home-assistant/aarch64-base:3.19",
    "amd64": "ghcr.io/home-assistant/amd64-base:3.19",
    "armv7": "ghcr.io/home-assistant/armv7-base:3.19"
  },
  "url": "https://github.com/cryptowhizzard/dwars-ems-homeassistant/tree/main/solaredge_agent",
  "hassio_api": true,
  "hassio_role": "default"
}
