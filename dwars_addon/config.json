{
  "name": "DWARS Generic EMS Add-on",
  "version": "0.1.1",
  "slug": "dwars_addon",
  "description": "Generieke DWARS EMS bridge voor andere omvormers. Stuurt zelf gekozen Home Assistant entities aan met configureerbare mode mapping.",
  "startup": "services",
  "boot": "auto",
  "homeassistant_api": true,
  "hassio_api": true,
  "stage": "experimental",
  "arch": [
    "aarch64",
    "armv7",
    "amd64"
  ],
  "init": false,
  "host_network": false,
  "options": {
    "api_url": "https://api.metdezon.nl/bms/api/next_action.php",
    "telemetry_url": "https://api.metdezon.nl/bms/api/telemetry.php",
    "api_key": "",
    "client_id": "",
    "poll_interval": 60,
    "power_watt": 5000,
    "debug": true,
    "ha_url": "",
    "ha_token": "",
    "soc_entity": "",
    "pv_entity": "",
    "grid_entity": "",
    "battery_power_entity": "",
    "inverter_mode_entity": "",
    "ha_control_enabled": true,
    "ha_mode_select": "",
    "ha_mode_map_json": "",
    "ha_mode_idle_option": "auto",
    "ha_mode_charge_option": "charge",
    "ha_mode_discharge_option": "discharge",
    "ha_server_modes_idle": "1,7",
    "ha_server_modes_charge": "3",
    "ha_server_modes_discharge": "4",
    "ha_power_number": "",
    "ha_charge_power_number": "",
    "ha_discharge_power_number": "",
    "ha_idle_power_number": "",
    "ha_charge_power_value": "server_power",
    "ha_discharge_power_value": "server_power",
    "ha_idle_power_value": "skip",
    "ha_set_power_before_mode": true,
    "backup_yaml_check_enabled": true,
    "backup_yaml_path": "/config/backup.yaml",
    "backup_yaml_overwrite": false
  },
  "schema": {
    "api_url": "str",
    "telemetry_url": "str?",
    "api_key": "str?",
    "client_id": "str?",
    "poll_interval": "int",
    "power_watt": "int",
    "debug": "bool",
    "ha_url": "str?",
    "ha_token": "str?",
    "soc_entity": "str?",
    "pv_entity": "str?",
    "grid_entity": "str?",
    "battery_power_entity": "str?",
    "inverter_mode_entity": "str?",
    "ha_control_enabled": "bool",
    "ha_mode_select": "str?",
    "ha_mode_map_json": "str?",
    "ha_mode_idle_option": "str?",
    "ha_mode_charge_option": "str?",
    "ha_mode_discharge_option": "str?",
    "ha_server_modes_idle": "str?",
    "ha_server_modes_charge": "str?",
    "ha_server_modes_discharge": "str?",
    "ha_power_number": "str?",
    "ha_charge_power_number": "str?",
    "ha_discharge_power_number": "str?",
    "ha_idle_power_number": "str?",
    "ha_charge_power_value": "str?",
    "ha_discharge_power_value": "str?",
    "ha_idle_power_value": "str?",
    "ha_set_power_before_mode": "bool",
    "backup_yaml_check_enabled": "bool",
    "backup_yaml_path": "str",
    "backup_yaml_overwrite": "bool"
  },
  "build_from": {
    "aarch64": "ghcr.io/home-assistant/aarch64-base:3.19",
    "amd64": "ghcr.io/home-assistant/amd64-base:3.19",
    "armv7": "ghcr.io/home-assistant/armv7-base:3.19"
  },
  "url": "https://github.com/cryptowhizzard/dwars-ems-homeassistant/tree/main/dwars_addon",
  "hassio_role": "default",
  "map": [
    "config:rw"
  ]
}
